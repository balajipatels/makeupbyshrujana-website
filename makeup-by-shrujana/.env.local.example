# ─────────────────────────────────────────────────────────────
# INSTAGRAM GRAPH API
# ─────────────────────────────────────────────────────────────
# Step 1: Switch your Instagram account to Professional (Business or Creator)
#         Settings → Account → Switch to Professional Account
#
# Step 2: Create a Meta Developer App
#         https://developers.facebook.com → My Apps → Create App → Consumer
#
# Step 3: Add "Instagram Graph API" product to the app
#
# Step 4: Generate a short-lived token from the Instagram Basic Display section,
#         then exchange for a long-lived token (~60 days) via:
#         GET https://graph.instagram.com/access_token
#           ?grant_type=ig_exchange_token
#           &client_id={APP_ID}
#           &client_secret={APP_SECRET}
#           &access_token={SHORT_LIVED_TOKEN}
#
# Step 5: Get your Instagram User ID:
#         GET https://graph.instagram.com/me?fields=id&access_token={TOKEN}
#
# Step 6: Add both values below, then set them in Vercel → Project → Settings → Environment Variables
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token_here
INSTAGRAM_USER_ID=your_numeric_instagram_user_id_here

# Token auto-refresh (runs via /api/instagram/refresh?secret=CRON_SECRET every 30 days)
# Set a random secret string here and in Vercel env vars
CRON_SECRET=any_random_secret_string_here


# ─────────────────────────────────────────────────────────────
# GOOGLE PLACES API (for live reviews)
# ─────────────────────────────────────────────────────────────
# Step 1: Go to https://console.cloud.google.com
#         Create a new project → Enable "Places API (New)"
#
# Step 2: Create an API Key
#         APIs & Services → Credentials → Create Credentials → API Key
#         Restrict to: HTTP referrers → https://makeup-by-shrujana.vercel.app/*
#
# Step 3: Find your Place ID for "MakeUpByShrujana"
#         https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
#         Search for "MakeUpByShrujana Bengaluru" and copy the Place ID
#
# Step 4: Add both values below and in Vercel env vars
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=ChIJ_your_place_id_here
